<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Головне вікно UWFix. Логіка — у ua.uwfix.ui.MainController.
     Тексти «%ключ» беруться зі словників ua/uwfix/i18n/messages_*.properties -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            styleClass="root-pane">

    <!-- ===================== Шапка ===================== -->
    <top>
        <HBox styleClass="header" alignment="CENTER_LEFT" spacing="14">
            <ImageView fitWidth="44" fitHeight="44" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@icon.png" smooth="true"/>
                </image>
            </ImageView>
            <VBox spacing="1" alignment="CENTER_LEFT">
                <Label text="UWFix" styleClass="app-title"/>
                <Label text="%header.subtitle" styleClass="app-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="%header.language" styleClass="caption"/>
                <ComboBox fx:id="languageCombo" prefWidth="150"/>
            </VBox>
            <VBox spacing="5" alignment="CENTER_LEFT">
                <Label text="%header.target" styleClass="caption"/>
                <ComboBox fx:id="ratioCombo" prefWidth="310" styleClass="ratio-combo"/>
            </VBox>
        </HBox>
    </top>

    <!-- ===================== Список ігор ===================== -->
    <left>
        <VBox styleClass="sidebar" spacing="10" prefWidth="320" minWidth="260">
            <TextField fx:id="searchField" promptText="%sidebar.search" styleClass="search-field"/>
            <HBox spacing="8">
                <ComboBox fx:id="filterCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="list-option"/>
                <ComboBox fx:id="sortCombo" HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="list-option"/>
            </HBox>
            <ListView fx:id="gameList" VBox.vgrow="ALWAYS" styleClass="game-list"/>
            <CheckBox fx:id="autostartCheck" text="%sidebar.autostart"
                      wrapText="true" styleClass="autostart-check"/>
            <HBox spacing="8">
                <Button fx:id="addGameButton" text="%sidebar.add" onAction="#onAddGame"
                        HBox.hgrow="ALWAYS" maxWidth="Infinity" styleClass="secondary-button"/>
                <Button fx:id="refreshButton" onAction="#onRefresh" styleClass="icon-button"/>
            </HBox>
        </VBox>
    </left>

    <!-- ===================== Деталі гри ===================== -->
    <center>
        <VBox styleClass="content" spacing="12">
            <HBox fx:id="updateBanner" styleClass="banner, banner-update" alignment="CENTER_LEFT" spacing="12">
                <Label text="⬆" styleClass="banner-icon"/>
                <Label fx:id="updateLabel" styleClass="banner-text" wrapText="true" HBox.hgrow="ALWAYS"
                       maxWidth="Infinity"/>
                <Hyperlink fx:id="updateNotesLink" text="%update.whatsNew" onAction="#onUpdateNotes"
                           styleClass="banner-link"/>
                <Button fx:id="updateButton" text="%update.install" onAction="#onUpdate" styleClass="accent-button"/>
            </HBox>
            <HBox fx:id="outdatedBanner" styleClass="banner" alignment="CENTER_LEFT" spacing="12" visible="false">
                <Label text="⬆" styleClass="banner-icon"/>
                <Label fx:id="outdatedLabel" styleClass="banner-text" wrapText="true" HBox.hgrow="ALWAYS"
                       maxWidth="Infinity"/>
                <Button fx:id="reapplyAllButton" text="%action.reapply" onAction="#onReapplyAll"
                        styleClass="accent-button"/>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS">
                <VBox fx:id="placeholder" styleClass="placeholder" alignment="CENTER" spacing="10">
                    <Label text="⟷" styleClass="placeholder-icon"/>
                    <Label fx:id="placeholderTitle" styleClass="placeholder-title"/>
                    <Label fx:id="placeholderText" styleClass="placeholder-text" wrapText="true" maxWidth="460"/>
                </VBox>

                <VBox fx:id="detailsPane" spacing="12" visible="false">
                    <!-- Шапка гри: на тлі — обкладинка зі Steam (якщо є) із затемненням -->
                    <StackPane fx:id="heroPane" styleClass="hero">
                        <Region fx:id="heroShade" styleClass="hero-shade" visible="false"/>
                        <VBox spacing="10" StackPane.alignment="BOTTOM_LEFT" styleClass="hero-content">
                            <HBox spacing="14" alignment="CENTER_LEFT">
                                <StackPane fx:id="gameIconBox" minWidth="48" minHeight="48" maxWidth="48" maxHeight="48"/>
                                <VBox spacing="2" HBox.hgrow="ALWAYS">
                                    <ImageView fx:id="gameLogo" fitWidth="420" fitHeight="76" preserveRatio="true"
                                               smooth="true" visible="false"/>
                                    <Label fx:id="gameTitle" styleClass="game-title" wrapText="true"/>
                                    <Hyperlink fx:id="gamePath" onAction="#onOpenFolder" styleClass="path-link"/>
                                </VBox>
                                <Button fx:id="playButton" text="%action.play" onAction="#onPlay" minWidth="-Infinity"
                                        styleClass="play-button, big-button"/>
                            </HBox>
                            <FlowPane fx:id="chips" hgap="8" vgap="6"/>
                        </VBox>
                    </StackPane>

                    <HBox fx:id="statusCard" styleClass="status-card, status-idle" spacing="14" alignment="CENTER_LEFT">
                        <Label fx:id="statusIcon" styleClass="status-icon" minWidth="44" alignment="CENTER"/>
                        <VBox spacing="3" HBox.hgrow="ALWAYS">
                            <Label fx:id="statusTitle" styleClass="status-title"/>
                            <Label fx:id="statusText" styleClass="status-text" wrapText="true"/>
                        </VBox>
                    </HBox>

                    <Label fx:id="engineHint" styleClass="hint" wrapText="true" minHeight="-Infinity"/>

                    <HBox fx:id="resolutionRow" styleClass="resolution-row" spacing="12" alignment="CENTER_LEFT">
                        <Label text="⟷" styleClass="resolution-icon"/>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="%settings.title" styleClass="resolution-title"/>
                            <Label fx:id="resolutionText" styleClass="hint" wrapText="true"/>
                        </VBox>
                        <Button fx:id="resolutionButton" onAction="#onSetResolution" styleClass="secondary-button"/>
                    </HBox>

                    <Label text="%details.files" styleClass="caption"/>
                    <TableView fx:id="fileTable" VBox.vgrow="ALWAYS" styleClass="file-table" minHeight="140"/>

                    <CheckBox fx:id="doubleCheck" text="%details.double"/>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button fx:id="fixButton" text="%action.fix" onAction="#onFix"
                                styleClass="accent-button, big-button"/>
                        <Button fx:id="restoreButton" text="%action.restore" onAction="#onRestore"
                                styleClass="secondary-button, big-button"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <VBox fx:id="progressBox" spacing="4" alignment="CENTER_RIGHT">
                            <Label fx:id="progressLabel" styleClass="progress-label" maxWidth="320"/>
                            <ProgressBar fx:id="progressBar" prefWidth="320"/>
                        </VBox>
                    </HBox>
                </VBox>
            </StackPane>

            <TitledPane fx:id="logPane" text="%log.title" expanded="false" styleClass="log-pane">
                <TextArea fx:id="logArea" editable="false" wrapText="true" prefRowCount="7" styleClass="log-area"/>
            </TitledPane>
        </VBox>
    </center>

    <!-- ===================== Рядок стану ===================== -->
    <bottom>
        <HBox styleClass="status-bar" spacing="20" alignment="CENTER_LEFT">
            <Label fx:id="gamesCountLabel"/>
            <Label fx:id="monitorLabel"/>
            <Label fx:id="adminLabel"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="versionLabel"/>
        </HBox>
    </bottom>
</BorderPane>
